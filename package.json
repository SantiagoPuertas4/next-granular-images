{
  "name": "next-granular-images",
  "version": "1.1.0",
  "description": "Granular image optimization for Next.js with separate quality control for AVIF/WebP",
  "keywords": [
    "next",
    "nextjs",
    "image",
    "image-optimization",
    "sharp",
    "avif",
    "webp",
    "blur-placeholder",
    "responsive-images",
    "art-direction"
  ],
  "main": "./dist/client/index.js",
  "module": "./dist/client/index.mjs",
  "types": "./dist/client/index.d.ts",
  "sideEffects": false,
  "bin": {
    "next-granular-images": "dist/cli/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SantiagoPuertas4/next-granular-images.git"
  },
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.mjs",
      "require": "./dist/client/index.js"
    },
    "./cli": {
      "import": "./dist/cli/index.mjs",
      "require": "./dist/cli/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:pipeline": "vitest run --project pipeline",
    "test:types": "vitest run --project typegen",
    "test:cli": "vitest run --project cli",
    "test:react": "vitest run --project react",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "next": ">=13.0.0",
    "react": ">=18.0.0",
    "sharp": "^0.33.0 || ^0.34.0"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "jiti": "^1.21.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jsdom": "27.4.0",
    "p-queue": "8.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.33.5",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "4.1.11"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "renovate": {
    "rangeStrategy": "pin",
    "minimumReleaseAge": "30 days",
    "labels": [
      "deps"
    ],
    "dependencyDashboard": true
  },
  "author": "Santiago Puertas",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SantiagoPuertas4/next-granular-images/issues"
  },
  "homepage": "https://github.com/SantiagoPuertas4/next-granular-images#readme"
}
